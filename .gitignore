# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads and Outputs (ignore content, keep directory)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# MCP test outputs
mcp-servers/**/test-output/*
!mcp-servers/**/test-output/.gitkeep
mcp-servers/**/test-assets/*
!mcp-servers/**/test-assets/.gitkeep
